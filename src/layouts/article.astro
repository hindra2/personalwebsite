---
import { ArrowLeft } from "lucide-react";

import ImageZoom from "@/components/image-zoom.astro";
import Base from "@/layouts/base.astro";

/**
 * Shared frame for blog posts and project pages, so they stay the same width
 * and keep the same back link and image zoom.
 */
interface Props {
    description?: string;
    /** Where "back" goes, e.g. "/#blog". */
    backHref: string;
}

const { description, backHref } = Astro.props;
---

<Base description={description}>
    <div class="min-h-screen text-text bg-linear-to-br from-background2 to-background">
        <div class="max-w-3xl mx-auto px-5 py-12 md:py-20">
            <a
                href={backHref}
                class="inline-flex items-center gap-1 text-sm font-mono text-text/70 hover:text-text"
            >
                <ArrowLeft size={16} /> back
            </a>

            <article class="mt-8">
                <slot />
            </article>
        </div>
    </div>

    <ImageZoom />
</Base>
